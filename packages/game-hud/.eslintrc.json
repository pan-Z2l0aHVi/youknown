{
	"extends": [
		"eslint:recommended",
		"plugin:vue/vue3-essential",
		"../../.eslintrc.base.json"],
	"parser": "vue-eslint-parser",
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module",
		"parser": "@typescript-eslint/parser"
	},
	"settings": {
		"react": {
			"versions": "detect"
		}
	},
	"plugins": [
		"vue",
		"@typescript-eslint",
		"react-hooks"
	],
	"rules": {
		"vue/multi-word-component-names": 0,
		"react-hooks/rules-of-hooks": "error",
		"react-hooks/exhaustive-deps": "warn"
	}
}
